{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SovereignPDF",
  "version": "0.1.6",
  "identifier": "org.sovereignpdf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SovereignPDF",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "contentTypes": ["com.adobe.pdf"],
        "mimeType": "application/pdf",
        "role": "Editor",
        "rank": "Default"
      }
    ],
    "windows": {
      "nsis": {
        "compression": "lzma"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  }
}
