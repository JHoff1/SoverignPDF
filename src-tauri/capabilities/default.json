{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local document access for VerityPDF document windows",
  "windows": ["main", "document-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/JHoff1/VerityPDF/issues*"
        },
        {
          "url": "https://github.com/JHoff1/VerityPDF"
        },
        {
          "url": "https://github.com/JHoff1/VerityPDF/blob/main/PRIVACY.md"
        }
      ]
    }
  ]
}
